# Copy this file to `.env` and fill in your real keys.
# `.env` is gitignored; this `.env.example` is committed as a template.

# ---- Required ----
# OpenAI is always required (PhIDO uses GPT for pydantic schema formatting,
# even when the main step is run with another provider).
OPENAI_API_KEY=

# ---- Optional: third-party OpenAI-compatible gateway ----
# Set OPENAI_BASE_URL to route GPT *and* Claude calls through an
# OpenAI-compatible proxy (e.g. GPTsAPI: https://api.gptsapi.net/v1).
# When this is set, OPENAI_API_KEY is reused for Claude as well and the
# native Anthropic SDK / thinking blocks are bypassed (the proxy only
# implements /v1/chat/completions, not /v1/messages).
# Leave empty to use api.openai.com directly.
OPENAI_BASE_URL=

# ---- Optional (enable as needed) ----
# Required only when calling Anthropic api.anthropic.com directly. When
# OPENAI_BASE_URL points at a proxy that already proxies Claude, this can
# stay empty.
ANTHROPIC_API_KEY=
GOOGLEGENAI_API_KEY=
DEEPSEEK_API_KEY=
NVIDIA_API_KEY=

# ---- Optional: LangSmith tracing for the LangGraph PoC ----
# When LANGSMITH_API_KEY is present, PhotonicsAI/graph/tracing.py auto-
# enables LangChain tracing v2. Otherwise tracing is a no-op.
LANGSMITH_API_KEY=
LANGCHAIN_PROJECT=phido-reflexion

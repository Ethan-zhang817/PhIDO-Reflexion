# =============================================================================
# PhIDO project specific
# =============================================================================

# Runtime logs (the directory itself is needed; ignore its contents)
PhotonicsAI/log/*
!PhotonicsAI/log/.gitkeep

# Build artifacts created by PhotonicsAI/config.py (PATH.build.mkdir)
/build/

# Streamlit local state
.streamlit/secrets.toml

# DRC artifacts (the committed report.lydrb is kept; ignore newly generated ones)
PhotonicsAI/Photon/drc/*.lydrb.bak
PhotonicsAI/Photon/drc/*.tmp

# Generated layouts / netlists / temp circuit files
# (Comment out lines below if you intentionally want to commit any of these.)
*.gds
*.oas
*.lyrdb
PhotonicsAI/Photon/CIRCUIT_*.yaml
!PhotonicsAI/Photon/CIRCUIT_wdd0.yaml

# Matplotlib / pyplot rendered output if dropped at repo root
matplotlib_*.png

# Core dumps from KLayout etc.
core
core.*
vgcore.*

# =============================================================================
# Secrets — NEVER commit
# =============================================================================
.env
.env.*
!.env.example
*.pem
*.key
secrets.yaml
credentials.json
